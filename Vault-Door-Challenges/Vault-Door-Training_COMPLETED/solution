#!/bin/bash

# Extract history strictly after the LATEST 'clear' command, removing Zsh line numbers safely
recorded_commands=$(history | awk '
{
    line = $0
    # Strip leading Zsh history line numbers and whitespace
    sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "", line)
    if (line == "clear") {
        clear_idx = NR
    }
    all_lines[NR] = line
    max_nr = NR
}
END {
    start = (clear_idx ? clear_idx + 1 : 1)
    # Loop from after the last clear up to the second-to-last command (skipping this script itself)
    for (i = start; i < max_nr; i++) {
        print all_lines[i]
    }
}')

# Generate the 'solution' script with formatting and spacing for outputs
cat << 'EOF' > ./solution
#!/bin/bash

run_cmd() {
    local c="$1"
    echo ""
    echo "┌──────────────────────────────────────────────────────────────────"
    echo "│ 🚀 RUNNING: $c"
    echo "└──────────────────────────────────────────────────────────────────"
    eval "$c"
    echo -e "\n"
}

EOF

# Append each command safely into the solution execution loop
while IFS= read -r cmd; do
    if [ -n "$cmd" ]; then
        # Escape quotes so special characters don't break the script
        escaped_cmd=$(printf '%s\n' "$cmd" | sed 's/"/\\"/g' | sed 's/\\/\\\\/g')
        echo "run_cmd \"$escaped_cmd\"" >> ./solution
    fi
done <<< "$recorded_commands"

chmod +x solution
echo "✅ Done! 'solution' created successfully. Run it with: ./solution"