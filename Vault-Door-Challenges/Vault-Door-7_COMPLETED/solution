#!/bin/bash

run_cmd() {
    local c="$1"
    echo ""
    echo "===================================================================="
    echo "INPUT:  $c"
    echo "--------------------------------------------------------------------"
    echo "OUTPUT:"
    
    # Check if the command is interactive or an editor/generator, so we log it 
    # as text but don't hang the script by running eval on it.
    if [[ "$c" =~ ^(subl|nano|vim|vi|gedit|\./generate|\. /generate|java|javac|save|finish)[[:space:]]* ]]; then
        echo "[Note: This interactive or editor command was logged for review, but skipped during automated execution to prevent freezing.]"
    else
        eval "$c"
    fi
    
    echo "===================================================================="
    echo -e "\n"
}

run_cmd "wget https://challenge-files.cylabacademy.net/library/e0a585d4aad18d8fe1bd87ae028cd201a7696ad85a36a64caa820fb503f47dd2/VaultDoor7.java"
run_cmd "ls"
run_cmd "cat VaultDoor7.java"
run_cmd "subl solve_int-bytes-to-hex-bytes-to-chars.py"
run_cmd "python3 solve_int-bytes-to-hex-bytes-to-chars.py"
run_cmd "cat solve_int-bytes-to-hex-bytes-to-chars.py"
run_cmd "python3 solve_int-bytes-to-hex-bytes-to-chars.py"
run_cmd "save"
